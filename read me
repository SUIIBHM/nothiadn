#include <iostream>
#include <vector>
#include <string>
#include <algorithm>

using namespace std;

// 1. Plain struct for holding data (no functions inside)
struct Student {
    int id;
    string name;
    float cgpa;
};

// 2. Display function (defined separately)
void displayStudents(const vector<Student>& students) {
    cout << "\nID\tName\tCGPA\n---------------------\n";
    for (const auto& s : students) {
        cout << s.id << "\t" << s.name << "\t" << s.cgpa << "\n";
    }
}

// 3. Linear Search function (defined separately)
int linearSearch(const vector<Student>& students, int id) {
    for (size_t i = 0; i < students.size(); i++) {
        if (students[i].id == id) {
            return i;
        }
    }
    return -1;
}

// 4. Binary Search function (defined separately)
int binarySearch(const vector<Student>& students, int id) {
    int low = 0, high = students.size() - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (students[mid].id == id) return mid;
        if (students[mid].id < id) low = mid + 1;
        else high = mid - 1;
    }
    return -1;
}

// 5. Bubble Sort by Name (defined separately)
void bubbleSortByName(vector<Student>& students) {
    for (size_t i = 0; i < students.size() - 1; i++) {
        for (size_t j = 0; j < students.size() - i - 1; j++) {
            if (students[j].name > students[j + 1].name) {
                swap(students[j], students[j + 1]);
            }
        }
    }
	
}

// 6. Insertion Sort by ID for Binary Search (defined separately)
void sortByID(vector<Student>& students) {
    for (size_t i = 1; i < students.size(); i++) {
        Student key = students[i];
        int j = i - 1;
        while (j >= 0 && students[j].id > key.id) {
            students[j + 1] = students[j];
            j--;
        }
        students[j + 1] = key;
    }
}

int main() {
    // We use a vector directly instead of a database object/struct
    vector<Student> students;

    // Adding students directly using push_back
    students.push_back({104, "Aman", 8.5});
    students.push_back({101, "Shubham", 9.1});
    students.push_back({103, "Rahul", 7.8});

    displayStudents(students);

    // Calling search function directly
    cout << "\nSearching for ID 103 using Linear Search...\n";
    int index = linearSearch(students, 103);
    cout << "Found at index: " << index << "\n";

    // Calling sort functions directly
    cout << "\nSorting by Name (Bubble Sort)...\n";
    bubbleSortByName(students);
    displayStudents(students);

    cout << "\nSorting by ID for Binary Search...\n";
    sortByID(students);
    cout << "Searching for ID 103 using Binary Search...\n";
    cout << "Found at index: " << binarySearch(students, 103) << "\n";

    return 0;
}




