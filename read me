#include<iostream>
#include<bits/stdc++.h>
using namespace std;

void heapify(int arr[],int n,int i){
    int largest = i;
    int left = 2*i+1;
    int right = 2*i+2;

    if(left<n && arr[left]>arr[largest]){
      largest = left;
    }
    if(right<n && arr[right]>arr[largest]){
        largest =right;
    }
    if(largest!=i){
        swap(arr[i],arr[largest]);
        heapify(arr,n,largest);
    }
}

void sort(int arr[],int n){
  for(int i=n/2  - 1;i>=0;i--){
      heapify(arr,n,i);
  }

  for(int i=n-1;i>=0;i--){
    swap(arr[0],arr[i]);
    heapify(arr,i,0);
  }
}

int main(){
    int n =6;
    int arr[n]={4,5,6,8,4,0};
    cout<<"This is unsorted array : ";
    for(int j=0;j<n;j++){
        cout<<arr[j]<<" ";
    }
    cout<<endl;
    sort(arr,n);
    cout<<"The sorted array in ascending order is : ";
    for(int p=0;p<n;p++){
        cout<<arr[p]<<" ";
    }
    cout<<endl;
}








