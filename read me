
#include <GL/glut.h>

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    glColor3f(1,0,0);
    glBegin(GL_LINE_STRIP);

    for(float t=0; t<=1; t+=0.01)
    {
        float x = (1-t)*(1-t)*-0.8
                + 2*t*(1-t)*0
                + t*t*0.8;

        float y = (1-t)*(1-t)*-0.5
                + 2*t*(1-t)*0.8
                + t*t*-0.5;

        glVertex2f(x,y);
    }

    glEnd();
    glFlush();
}

int main(int argc,char** argv)
{
    glutInit(&argc,argv);
    glutInitWindowSize(500,500);
    glutCreateWindow("Bezier Curve");
    glutDisplayFunc(display);
    glutMainLoop();
}




















#include <GL/glut.h>
#include <math.h>

void koch(float x1,float y1,float x2,float y2,int n)
{
    if(n==0)
    {
        glVertex2f(x1,y1);
        glVertex2f(x2,y2);
        return;
    }

    float dx=(x2-x1)/3;
    float dy=(y2-y1)/3;

    float x3=x1+dx, y3=y1+dy;
    float x4=x2-dx, y4=y2-dy;

    float x5=(x3+x4)/2-(y4-y3)*0.866;
    float y5=(y3+y4)/2+(x4-x3)*0.866;

    koch(x1,y1,x3,y3,n-1);
    koch(x3,y3,x5,y5,n-1);
    koch(x5,y5,x4,y4,n-1);
    koch(x4,y4,x2,y2,n-1);
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);
    glColor3f(0,0,1);

    glBegin(GL_LINES);
    koch(-0.8,0,0.8,0,3);
    glEnd();

    glFlush();
}

int main(int argc,char** argv)
{
    glutInit(&argc,argv);
    glutInitWindowSize(500,500);
    glutCreateWindow("Koch Curve");
    glutDisplayFunc(display);
    glutMainLoop();
}









































#include <GL/glut.h>
#include <iostream>
using namespace std;

class Point
{
public:
    float x, y;

    Point operator + (Point p)
    {
        return {x+p.x, y+p.y};
    }

    Point operator * (float s)
    {
        return {x*s, y*s};
    }
};

Point a={-0.5,-0.5}, b={0.5,-0.5}, c={0,0.5};

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);
    glColor3f(1,0,0);

    glBegin(GL_TRIANGLES);

    glVertex2f(a.x,a.y);
    glVertex2f(b.x,b.y);
    glVertex2f(c.x,c.y);

    glEnd();
    glFlush();
}

int main(int argc,char** argv)
{
    glutInit(&argc,argv);
    glutInitWindowSize(500,500);
    glutCreateWindow("2D Transformations");

    Point t={0.2,0.2};

    // Translation
    a=a+t; b=b+t; c=c+t;

    // Scaling
    a=a*1.5; b=b*1.5; c=c*1.5;

    // Rotation (90 degrees)
    Point temp;
    temp.x=-a.y; temp.y=a.x; a=temp;
    temp.x=-b.y; temp.y=b.x; b=temp;
    temp.x=-c.y; temp.y=c.x; c=temp;

    glutDisplayFunc(display);
    glutMainLoop();
}
























#include <GL/glut.h>

void plot(int x, int y)
{
    glBegin(GL_POINTS);
    glVertex2i(x, y);
    glVertex2i(-x, y);
    glVertex2i(x, -y);
    glVertex2i(-x, -y);
    glVertex2i(y, x);
    glVertex2i(-y, x);
    glVertex2i(y, -x);
    glVertex2i(-y, -x);
    glEnd();
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);
    glColor3f(1, 0, 0);

    int x = 0, y = 100;
    int p = 1 - y;

    while (x <= y)
    {
        plot(x, y);
        x++;

        if (p < 0)
            p = p + 2*x + 1;
        else
        {
            y--;
            p = p + 2*(x-y) + 1;
        }
    }

    glFlush();
}

int main(int argc, char** argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);
    glutCreateWindow("Midpoint Circle");

    gluOrtho2D(-250, 250, -250, 250);

    glutDisplayFunc(display);
    glutMainLoop();

    return 0;
}



























































#include <GL/glut.h>
#include <cmath>
#include <cstdlib>
#include <iostream>

using namespace std;

int x1, y1, x2, y2, count = 0;
int style = 1; // 1: Solid, 2: Dashed, 3: Dotted

void drawDDALine()
{
    float dx = x2 - x1;
    float dy = y2 - y1;
    float steps = (abs(dx) > abs(dy)) ? abs(dx) : abs(dy);

    float xinc = dx / steps;
    float yinc = dy / steps;

    float x = x1;
    float y = y1;

    glBegin(GL_POINTS);

    for (int i = 0; i <= steps; i++)
    {
        // Apply line styles based on the pixel index 'i'
        if (style == 1 || (style == 2 && i % 4 == 0) || (style == 3 && i % 12 < 7))
        {
            glVertex2i(round(x), round(y));
        }

        x += xinc;
        y += yinc;
    }

    glEnd();
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    // Draw crosshair axes at the center of the 600x600 window (at 300, 300)
    glColor3f(1, 1, 1);
    glBegin(GL_LINES);
    glVertex2i(0, 300); 
    glVertex2i(600, 300);
    glVertex2i(300, 0); 
    glVertex2i(300, 600);
    glEnd();

    // Draw the red line if both points are selected
    if (count == 2)
    {
        glColor3f(1, 0, 0);
        drawDDALine();
    }

    glFlush();
}

void mouse(int b, int s, int x, int y)
{
    if (b == GLUT_LEFT_BUTTON && s == GLUT_DOWN)
    {
        if (count == 0 || count == 2)
        {
            x1 = x;
            y1 = y;
            count = 1;
        }
        else if (count == 1)
        {
            x2 = x;
            y2 = y;
            count = 2;
        }
        glutPostRedisplay();
    }
}

void keyboard(unsigned char k, int x, int y)
{
    if (k == '1') 
    {
        style = 1; // Solid line
    }
    if (k == '2') 
    {
        style = 2; // Dashed line
    }
    if (k == '3') 
    {
        style = 3; // Dotted line
    }

    glutPostRedisplay();
}

int main(int argc, char **argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(600, 600);
    glutCreateWindow("DDA Line Drawing - Mouse & Styles");

    glClearColor(0, 0, 0, 1);
    gluOrtho2D(0, 600, 600, 0);

    glutDisplayFunc(display);
    glutMouseFunc(mouse);
    glutKeyboardFunc(keyboard);

    glutMainLoop();
    return 0;
}





















































#include <GL/glut.h>
#include <cmath>
#include <cstdlib>
#include <iostream>

using namespace std;

int x1, y1, x2, y2, count = 0;
int style = 1; // 1: Solid, 2: Dashed, 3: Dotted

void drawBresenhamLine()
{
    int dx = abs(x2 - x1);
    int dy = abs(y2 - y1);
    int sx = (x1 < x2) ? 1 : -1;
    int sy = (y1 < y2) ? 1 : -1;
    int err = dx - dy;

    int x = x1;
    int y = y1;
    int i = 0; // Pixel counter used for line styles

    glBegin(GL_POINTS);

    while (true)
    {
        // Apply line styles based on the pixel index 'i'
        if (style == 1 || (style == 2 && i % 4 == 0) || (style == 3 && i % 12 < 7))
        {
            glVertex2i(x, y);
        }

        if (x == x2 && y == y2)
        {
            break;
        }

        int e2 = 2 * err;

        if (e2 > -dy)
        {
            err -= dy;
            x += sx;
        }

        if (e2 < dx)
        {
            err += dx;
            y += sy;
        }

        i++; // Increment the pixel step count
    }

    glEnd();
}

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);

    // Draw crosshair axes at the center of the 600x600 window (at 300, 300)
    glColor3f(1, 1, 1);
    glBegin(GL_LINES);
    glVertex2i(0, 300); 
    glVertex2i(600, 300);
    glVertex2i(300, 0); 
    glVertex2i(300, 600);
    glEnd();

    // Draw the red line if both points are selected
    if (count == 2)
    {
        glColor3f(1, 0, 0);
        drawBresenhamLine();
    }

    glFlush();
}

void mouse(int b, int s, int x, int y)
{
    if (b == GLUT_LEFT_BUTTON && s == GLUT_DOWN)
    {
        if (count == 0 || count == 2)
        {
            x1 = x;
            y1 = y;
            count = 1;
        }
        else if (count == 1)
        {
            x2 = x;
            y2 = y;
            count = 2;
        }
        glutPostRedisplay();
    }
}

void keyboard(unsigned char k, int x, int y)
{
    if (k == '1') 
    {
        style = 1; // Solid line
    }
    if (k == '2') 
    {
        style = 2; // Dashed line
    }
    if (k == '3') 
    {
        style = 3; // Dotted line
    }

    glutPostRedisplay();
}

int main(int argc, char **argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(600, 600);
    glutCreateWindow("Bresenham Line Drawing - Mouse & Styles");

    glClearColor(0, 0, 0, 1);
    gluOrtho2D(0, 600, 600, 0);

    glutDisplayFunc(display);
    glutMouseFunc(mouse);
    glutKeyboardFunc(keyboard); // Added keyboard back so you can switch styles 1, 2, or 3!

    glutMainLoop();
    return 0;
}
