import java.util.Scanner ;
class pallindore{
   public static void main(String[] args){
      Scanner sc = new Scanner(System.in);
      System.out.println("Enter the number : ");
      long n=sc.nextInt();
         
      long temp=n;long rev=0;
      while(temp>0){
         rev= rev*10+temp%10;
         temp/=10;
      }
      if(n==rev){
      System.out.println("Given number is pallindrome ");
      }
      else{
          System.out.println("Given number is not pallindrome ");
      }
       System.out.println("");
        sc.nextLine();
       //for string
        System.out.println("Enter the String  ");
        String s=sc.nextLine();
         String ulta="";
        for(int i=s.length()-1;i>=0;i--){
           ulta=ulta+s.charAt(i);
        }
        if(s.equalsIgnoreCase(ulta)){
          System.out.println("Given String is pallindrome ");
        }
        else{
          System.out.println("Given String is not pallindrome ");
        }

        System.out.print("Enter N: ");
        int k = sc.nextInt();

        System.out.println("Armstrong numbers:");

        for (int num = 1; num <= k; num++) {
            int tmp = num;
            int digits = 0;
            int sum = 0;

            // Count digits
            int t = num;
            while (t > 0) {
                digits++;
                t = t / 10;
            }

            // Calculate Armstrong sum
            tmp = num;
            while (tmp > 0) {
                int digit = tmp % 10;
                sum += (int)Math.pow(digit, digits);
                tmp = tmp / 10;
            }

            if (sum == num) {
                System.out.println(num);
            }
        }
   }
   }


























class Student {

    String name;
    int m1, m2, m3, m4;

    // Default constructor
    Student() {
        name = "Subham";
        m1 = 40;
        m2 = 80;
        m3 = 89;
        m4 = 98;
    }

    // Parameterized constructor
    Student(String n, int a, int b, int c, int d) {
        name = n;
        setm1(a);
        setm2(b);
        setm3(c);
        setm4(d);
    }

    // Setter methods with validation
    void setm1(int a) {
        if (a >= 0 && a <= 100)
            m1 = a;
        else
            m1 = 0;
    }

    void setm2(int b) {
        if (b >= 0 && b <= 100)
            m2 = b;
        else
            m2 = 0;
    }

    void setm3(int c) {
        if (c >= 0 && c <= 100)
            m3 = c;
        else
            m3 = 0;
    }

    void setm4(int d) {
        if (d >= 0 && d <= 100)
            m4 = d;
        else
            m4 = 0;
    }

    // Calculate percentage and grade
    void calculate() {

        double percentage = (m1 + m2 + m3 + m4) / 4.0;

        System.out.println("Name: " + name);
        System.out.println("Percentage: " + percentage);

        if (percentage >= 90)
            System.out.println("Grade: A");
        else if (percentage >= 80)
            System.out.println("Grade: B");
        else if (percentage >= 70)
            System.out.println("Grade: C");
        else if (percentage >= 60)
            System.out.println("Grade: D");
        else
            System.out.println("Grade: F");
    }

    public static void main(String[] args) {

        Student s1 = new Student();
        Student s2 = new Student("Rahul", 80, 70, 60, 98);

        s1.calculate();

        System.out.println();

        s2.calculate();
    }
}
