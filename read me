#include <iostream>
using namespace std;
#define SIZE 5

struct Queue {
    int arr[SIZE];
    int front, rear;
};

void enqueue(Queue &q, int x) {
    if ((q.rear + 1) % SIZE == q.front) {
        cout << "Queue Full\n";
        return;
    }

    if (q.front == -1)
        q.front = 0;

    q.rear = (q.rear + 1) % SIZE;
    q.arr[q.rear] = x;
}

void dequeue(Queue &q) {
    if (q.front == -1) {
        cout << "Queue Empty\n";
        return;
    }

    cout << "Deleted: " << q.arr[q.front] << endl;


    if (q.front == q.rear)
        q.front = q.rear = -1;
    else
        q.front = (q.front + 1) % SIZE;
}

void display(Queue q) {
    if (q.front == -1) {
        cout << "Queue Empty\n";
        return;
    }

    int i = q.front;
    while (true) {
        cout << q.arr[i] << " ";
        if (i == q.rear)
            break;
        i = (i + 1) % SIZE;
    }
    cout << endl;
}

int main() {
    Queue q;
    q.front = q.rear = -1;
    int ch, x;

    do {
        cout << "\n1.Enqueue 2.Dequeue 3.Display 4.Exit\n";
        cin >> ch;

        switch (ch) {
            case 1:
                cout << "Enter value: ";
                cin >> x;
                enqueue(q, x);
                break;
            case 2:
                dequeue(q);
                break;
            case 3:
                display(q);
                break;
        }
    } while (ch != 4);

    return 0;
}







